# Copy the variables you need into your environment (the app reads os.environ; no .env loader is used).
SECRET_KEY=change-me
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=0
APP_ENV=producao
DATABASE_PATH=loja.db
# Comma-separated list; empty = no CORS headers
CORS_ORIGINS=
# Empty = /admin/* endpoints disabled (403)
ADMIN_TOKEN=
# 1 = enable the read-only SQL console at /admin/query (also requires ADMIN_TOKEN)
ALLOW_ADMIN_QUERY=0

# Copy to .env (or export the variables) and adjust. Never commit real secrets.
SECRET_KEY=change-me-to-a-long-random-value
APP_DEBUG=0
APP_HOST=127.0.0.1
APP_PORT=5000
APP_ENV=producao
DATABASE_PATH=loja.db
# Comma-separated list, e.g. http://localhost:3000,https://loja.example.com
CORS_ORIGINS=
# Empty disables /admin/*; send it in the X-Admin-Token header
ADMIN_TOKEN=
# 1 enables the read-only POST /admin/query (still requires ADMIN_TOKEN)
ADMIN_SQL_QUERY_ENABLED=0

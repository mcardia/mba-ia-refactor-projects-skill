# Copy to .env and adjust. Every variable is optional; defaults are shown.

# Signing key for login tokens. If unset, a random key is generated at each boot.
SECRET_KEY=change-me-to-a-long-random-string
# SQLAlchemy URL; relative sqlite paths live in ./instance/
DATABASE_URL=sqlite:///tasks.db
APP_HOST=127.0.0.1
APP_PORT=5000
# 1 enables the Flask debugger (never in production)
APP_DEBUG=0
# Comma-separated list of allowed browser origins; empty = no CORS headers
CORS_ORIGINS=
# Lifetime of login tokens, in seconds
TOKEN_MAX_AGE_SECONDS=3600
LOG_LEVEL=INFO

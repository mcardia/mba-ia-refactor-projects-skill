# Copy to .env and adjust. Never commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///tasks.db
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=0
# Comma-separated list of allowed browser origins (empty = no cross-origin access)
CORS_ORIGINS=
# Token expected in the X-Admin-Token header for privileged routes (empty = those routes return 403)
ADMIN_TOKEN=
